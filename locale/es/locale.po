# Admin — index form -----------------------------------------------------

msgid "plugins.generic.indexingPageManager.admin.indexForm.title"
msgstr "Índice"

msgid "plugins.generic.indexingPageManager.admin.indexForm.addTitle"
msgstr "Añadir índice"

msgid "plugins.generic.indexingPageManager.admin.indexForm.editTitle"
msgstr "Editar índice"

msgid "plugins.generic.indexingPageManager.admin.indexForm.saved"
msgstr "Índice guardado."

msgid "plugins.generic.indexingPageManager.admin.indexForm.logo"
msgstr "Logotipo"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoChoose"
msgstr "Elegir logotipo"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoRemove"
msgstr "Quitar logotipo"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoPlaceholder"
msgstr "No se ha subido ningún logotipo"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoHelp"
msgstr "Recomendado: un logotipo horizontal de unos 400×150 px y de menos de ~100 KB. Si todos los logotipos tienen el mismo tamaño, la página se ve más ordenada y carga más rápido. Lo que mejor queda es un PNG con fondo transparente; se aceptan JPG, PNG o WebP."

msgid "plugins.generic.indexingPageManager.admin.indexForm.status"
msgstr "Estado"

msgid "plugins.generic.indexingPageManager.admin.indexForm.isActive"
msgstr "Activo (visible en la página pública)"

msgid "plugins.generic.indexingPageManager.admin.indexForm.isActiveHelp"
msgstr "Las entradas inactivas se conservan en la base de datos, pero no se muestran en el sitio público."

msgid "plugins.generic.indexingPageManager.admin.indexForm.sections"
msgstr "Secciones"

msgid "plugins.generic.indexingPageManager.admin.indexForm.details"
msgstr "Datos del índice"

msgid "plugins.generic.indexingPageManager.admin.indexForm.detailsHelp"
msgstr "Campos multilingües: complételos en cada idioma. La mayoría de los nombres de índices son marcas y se escriben igual en todos los idiomas."

msgid "plugins.generic.indexingPageManager.admin.indexForm.name"
msgstr "Nombre"

msgid "plugins.generic.indexingPageManager.admin.indexForm.description"
msgstr "Descripción breve (opcional)"

msgid "plugins.generic.indexingPageManager.admin.indexForm.descriptionHelp"
msgstr "Se muestra debajo del logotipo en las plantillas que incluyen la descripción. Texto sin formato; se elimina el HTML."

msgid "plugins.generic.indexingPageManager.admin.indexForm.link"
msgstr "Enlace externo"

msgid "plugins.generic.indexingPageManager.admin.indexForm.url"
msgstr "URL"

msgid "plugins.generic.indexingPageManager.admin.indexForm.urlHelp"
msgstr "Enlace al sitio web del propio índice. Debe empezar por http:// o https://."

msgid "plugins.generic.indexingPageManager.admin.indexForm.error.name"
msgstr "El nombre es obligatorio al menos en el idioma principal."

msgid "plugins.generic.indexingPageManager.admin.indexForm.error.sections"
msgstr "Elija al menos una sección."

msgid "plugins.generic.indexingPageManager.admin.indexForm.error.url"
msgstr "Introduzca una URL completa que empiece por http:// o https://."

# Admin — sections -------------------------------------------------------

msgid "plugins.generic.indexingPageManager.admin.sections.title"
msgstr "Secciones"

msgid "plugins.generic.indexingPageManager.admin.sections.subtitle"
msgstr "Las secciones integradas no se pueden eliminar, pero sí renombrar, reordenar u ocultar."

msgid "plugins.generic.indexingPageManager.admin.sections.backToIndexes"
msgstr "Volver a los índices"

msgid "plugins.generic.indexingPageManager.admin.sections.addSection"
msgstr "Añadir sección"

msgid "plugins.generic.indexingPageManager.admin.sections.builtIn"
msgstr "Integrada"

msgid "plugins.generic.indexingPageManager.admin.sections.custom"
msgstr "Personalizada"

msgid "plugins.generic.indexingPageManager.admin.sections.inactive"
msgstr "Oculta"

msgid "plugins.generic.indexingPageManager.admin.sections.empty.title"
msgstr "Todavía no hay secciones."

msgid "plugins.generic.indexingPageManager.admin.sections.error.cannotDeleteBuiltIn"
msgstr "Las secciones integradas no se pueden eliminar. Desactívelas para ocultarlas."

