msgid "plugins.generic.indexingPageManager.admin.sectionForm.title"
msgstr "Sección"

msgid "plugins.generic.indexingPageManager.admin.sectionForm.addTitle"
msgstr "Añadir sección"

msgid "plugins.generic.indexingPageManager.admin.sectionForm.editTitle"
msgstr "Editar sección"

msgid "plugins.generic.indexingPageManager.admin.sectionForm.saved"
msgstr "Sección guardada."

msgid "plugins.generic.indexingPageManager.admin.sectionForm.displayName"
msgstr "Nombre visible"

msgid "plugins.generic.indexingPageManager.admin.sectionForm.displayNameHelp"
msgstr "Es el título de la sección que ven los lectores. Tradúzcalo en cada idioma."

msgid "plugins.generic.indexingPageManager.admin.sectionForm.isActive"
msgstr "Activa"

msgid "plugins.generic.indexingPageManager.admin.sectionForm.isActiveHelp"
msgstr "Las secciones inactivas no se muestran en la página pública aunque contengan índices."

msgid "plugins.generic.indexingPageManager.admin.sectionForm.error.displayName"
msgstr "El nombre visible es obligatorio al menos en el idioma principal."

msgid "plugins.generic.indexingPageManager.admin.sectionForm.error.slug"
msgstr "No se pudo generar un identificador a partir del nombre visible. Introduzca primero un nombre visible."

# Admin — template selector ----------------------------------------------

msgid "plugins.generic.indexingPageManager.admin.templates.title"
msgstr "Plantilla"

