msgid "plugins.generic.indexingPageManager.admin.indexList.dragSection"
msgstr "Arrastre para reordenar la sección"

msgid "plugins.generic.indexingPageManager.admin.indexList.dragIndex"
msgstr "Arrastre para reordenar el índice"

msgid "plugins.generic.indexingPageManager.admin.indexList.sectionEmpty"
msgstr "Todavía no hay índices en esta sección."

msgid "plugins.generic.indexingPageManager.admin.indexList.empty.title"
msgstr "Todavía no hay índices"

msgid "plugins.generic.indexingPageManager.admin.indexList.empty.body"
msgstr "Empiece añadiendo su primera base de datos de indexación."

msgid "plugins.generic.indexingPageManager.admin.indexList.stats.total"
msgstr "Total de índices"

msgid "plugins.generic.indexingPageManager.admin.indexList.stats.active"
