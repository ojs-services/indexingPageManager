msgid "plugins.generic.indexingPageManager.admin.indexList.title"
msgstr "Индексы и базы данных"

msgid "plugins.generic.indexingPageManager.admin.indexList.subtitle"
msgstr "Составьте список баз данных, поисковых сервисов и платформ, с которыми работает ваш журнал."

msgid "plugins.generic.indexingPageManager.admin.indexList.preview"
msgstr "Предпросмотр"

