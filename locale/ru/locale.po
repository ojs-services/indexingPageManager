# Plugin metadata --------------------------------------------------------

msgid "plugins.generic.indexingPageManager.name"
msgstr "Менеджер страницы индексирования"

msgid "plugins.generic.indexingPageManager.description"
msgstr "Современная витрина баз данных индексирования, поисковых сервисов и издательских платформ, с которыми работает ваш журнал: управление из одной панели администратора, показ на отдельной странице или внутри темы."

msgid "plugins.generic.indexingPageManager.action.manage"
msgstr "Управление страницей индексирования"

# Navigation menu integration --------------------------------------------

msgid "plugins.generic.indexingPageManager.navMenuItem.title"
msgstr "Страница «Индексы и базы данных»"

msgid "plugins.generic.indexingPageManager.navMenuItem.description"
msgstr "Ссылка на витрину менеджера страницы индексирования с базами данных и платформами, в которых индексируется ваш журнал."

# Frontend ---------------------------------------------------------------

msgid "plugins.generic.indexingPageManager.frontend.defaultTitle"
msgstr "Индексы и базы данных"

# Built-in sections (slugs immutable; labels editable per locale) ---------

msgid "plugins.generic.indexingPageManager.builtIn.indexing-and-abstracting"
msgstr "Индексирование и реферирование"

msgid "plugins.generic.indexingPageManager.builtIn.discovery-and-search"
msgstr "Поиск и обнаружение"

msgid "plugins.generic.indexingPageManager.builtIn.identifiers-and-registration"
msgstr "Идентификаторы и регистрация"

msgid "plugins.generic.indexingPageManager.builtIn.archiving-and-preservation"
msgstr "Архивирование и сохранность"

# Display template + columns ---------------------------------------------

msgid "plugins.generic.indexingPageManager.settings.displayTemplate"
msgstr "Шаблон отображения"

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logos"
msgstr "Только логотип"

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logos.desc"
msgstr "Аккуратная сетка логотипов одинакового размера, без подписей."

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logo-name"
msgstr "Логотип + название"

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logo-name.desc"
msgstr "Под каждым логотипом показано название индекса."

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logo-name-desc"
msgstr "Логотип + название + описание"

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logo-name-desc.desc"
msgstr "Логотип, название индекса и короткая строка описания."

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logo-desc"
msgstr "Логотип + описание"

msgid "plugins.generic.indexingPageManager.settings.displayTemplate.logo-desc.desc"
msgstr "Логотип с кратким описанием, без названия."

msgid "plugins.generic.indexingPageManager.settings.displayColumns"
msgstr "Столбцы"

msgid "plugins.generic.indexingPageManager.settings.displayColumnsHelp"
msgstr "Логотипы масштабируются автоматически. На небольших экранах сетка сама переходит на меньшее число столбцов."

msgid "plugins.generic.indexingPageManager.template.error.invalid"
msgstr "Выберите один из доступных шаблонов."

# Settings page ----------------------------------------------------------

msgid "plugins.generic.indexingPageManager.settings.title"
msgstr "Менеджер страницы индексирования — настройки"

msgid "plugins.generic.indexingPageManager.settings.section.page"
msgstr "Страница"

msgid "plugins.generic.indexingPageManager.settings.section.display"
msgstr "Отображение"

msgid "plugins.generic.indexingPageManager.settings.section.seo"
msgstr "SEO"

msgid "plugins.generic.indexingPageManager.settings.pageTitle"
msgstr "Заголовок страницы"

msgid "plugins.generic.indexingPageManager.settings.introText"
msgstr "Вводный текст (показывается под заголовком)"

msgid "plugins.generic.indexingPageManager.settings.pageSlug"
msgstr "Адрес страницы (slug)"

msgid "plugins.generic.indexingPageManager.settings.pageSlugHelp"
msgstr "Страница доступна по адресу /about/<slug>. По умолчанию: databases."

msgid "plugins.generic.indexingPageManager.settings.error.pageSlug"
msgstr "Адрес должен начинаться с буквы и содержать только буквы, цифры и дефисы."

msgid "plugins.generic.indexingPageManager.settings.enableSchemaOrg"
msgstr "Встраивать JSON-LD Schema.org для SEO"

msgid "plugins.generic.indexingPageManager.settings.enableSchemaOrgHelp"
msgstr "Добавляет скрипт структурированных данных (CollectionPage с записями Organization), который помогает поисковым системам понять, какие базы данных индексируют ваш журнал."

msgid "plugins.generic.indexingPageManager.settings.status.heading"
msgstr "Состояние модуля"

msgid "plugins.generic.indexingPageManager.settings.status.activation"
msgstr "Активация"

msgid "plugins.generic.indexingPageManager.settings.status.enabled"
msgstr "Включён"

msgid "plugins.generic.indexingPageManager.settings.status.toggleHint"
msgstr "Чтобы отключить или снова включить модуль, откройте Настройки → Веб-сайт → Модули."

msgid "plugins.generic.indexingPageManager.settings.status.publicUrl"
msgstr "Публичная страница"

msgid "plugins.generic.indexingPageManager.settings.status.routeNote"
msgstr "Пока модуль включён, по этому адресу открывается ваша витрина. Её также можно добавить в любое меню навигации: Настройки → Веб-сайт → Навигация."

