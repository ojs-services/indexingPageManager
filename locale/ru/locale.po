msgstr "Добавить индекс"

msgid "plugins.generic.indexingPageManager.admin.indexList.addToThis"
msgstr "Добавить в этот раздел"

msgid "plugins.generic.indexingPageManager.admin.indexList.toggleActive"
msgstr "Включить или выключить"

msgid "plugins.generic.indexingPageManager.admin.indexList.dragSection"
msgstr "Перетащите, чтобы изменить порядок раздела"

msgid "plugins.generic.indexingPageManager.admin.indexList.dragIndex"
msgstr "Перетащите, чтобы изменить порядок индекса"

msgid "plugins.generic.indexingPageManager.admin.indexList.sectionEmpty"
msgstr "В этом разделе пока нет индексов."

msgid "plugins.generic.indexingPageManager.admin.indexList.empty.title"
msgstr "Индексов пока нет"

msgid "plugins.generic.indexingPageManager.admin.indexList.empty.body"
msgstr "Начните с добавления первой базы данных индексирования."

msgid "plugins.generic.indexingPageManager.admin.indexList.stats.total"
msgstr "Всего индексов"

msgid "plugins.generic.indexingPageManager.admin.indexList.stats.active"
msgstr "Активные"

msgid "plugins.generic.indexingPageManager.admin.indexList.stats.sections"
msgstr "Заполненные разделы"

msgid "plugins.generic.indexingPageManager.admin.indexList.stats.template"
msgstr "Активный шаблон"

msgid "plugins.generic.indexingPageManager.admin.indexList.stats.cols"
msgstr "стб."

# Admin — index form -----------------------------------------------------

msgid "plugins.generic.indexingPageManager.admin.indexForm.title"
msgstr "Индекс"

msgid "plugins.generic.indexingPageManager.admin.indexForm.addTitle"
msgstr "Добавить индекс"

msgid "plugins.generic.indexingPageManager.admin.indexForm.editTitle"
msgstr "Изменить индекс"

msgid "plugins.generic.indexingPageManager.admin.indexForm.saved"
msgstr "Индекс сохранён."

msgid "plugins.generic.indexingPageManager.admin.indexForm.logo"
msgstr "Логотип"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoChoose"
msgstr "Выбрать логотип"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoRemove"
msgstr "Удалить логотип"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoPlaceholder"
msgstr "Логотип не загружен"

msgid "plugins.generic.indexingPageManager.admin.indexForm.logoHelp"
msgstr "Рекомендуется горизонтальный логотип около 400×150 пикселей и не более ~100 КБ. Логотипы одного размера выглядят аккуратнее и ускоряют загрузку страницы. Лучше всего подходит PNG с прозрачным фоном; принимаются JPG, PNG и WebP."

msgid "plugins.generic.indexingPageManager.admin.indexForm.status"
msgstr "Статус"

msgid "plugins.generic.indexingPageManager.admin.indexForm.isActive"
msgstr "Активен (виден на публичной странице)"

msgid "plugins.generic.indexingPageManager.admin.indexForm.isActiveHelp"
msgstr "Неактивные записи остаются в базе данных, но не показываются на сайте."

msgid "plugins.generic.indexingPageManager.admin.indexForm.sections"
msgstr "Разделы"

msgid "plugins.generic.indexingPageManager.admin.indexForm.details"
msgstr "Сведения об индексе"

msgid "plugins.generic.indexingPageManager.admin.indexForm.detailsHelp"
msgstr "Многоязычные поля — заполните их для каждого языка. Большинство названий индексов — это бренды, которые пишутся одинаково на всех языках."

msgid "plugins.generic.indexingPageManager.admin.indexForm.name"
msgstr "Название"

msgid "plugins.generic.indexingPageManager.admin.indexForm.description"
msgstr "Краткое описание (необязательно)"

msgid "plugins.generic.indexingPageManager.admin.indexForm.descriptionHelp"
msgstr "Показывается под логотипом в шаблонах с описанием. Только текст; HTML удаляется."

msgid "plugins.generic.indexingPageManager.admin.indexForm.link"
msgstr "Внешняя ссылка"

msgid "plugins.generic.indexingPageManager.admin.indexForm.url"
msgstr "URL-адрес"

msgid "plugins.generic.indexingPageManager.admin.indexForm.urlHelp"
msgstr "Ссылка на собственный сайт индекса. Должна начинаться с http:// или https://."

msgid "plugins.generic.indexingPageManager.admin.indexForm.error.name"
msgstr "Название обязательно хотя бы для основного языка."

msgid "plugins.generic.indexingPageManager.admin.indexForm.error.sections"
msgstr "Выберите хотя бы один раздел."

msgid "plugins.generic.indexingPageManager.admin.indexForm.error.url"
msgstr "Введите полный адрес, начинающийся с http:// или https://."

# Admin — sections -------------------------------------------------------

msgid "plugins.generic.indexingPageManager.admin.sections.title"
msgstr "Разделы"

msgid "plugins.generic.indexingPageManager.admin.sections.subtitle"
msgstr "Встроенные разделы нельзя удалить, но можно переименовать, переупорядочить или скрыть."

msgid "plugins.generic.indexingPageManager.admin.sections.backToIndexes"
msgstr "Назад к индексам"

msgid "plugins.generic.indexingPageManager.admin.sections.addSection"
msgstr "Добавить раздел"

msgid "plugins.generic.indexingPageManager.admin.sections.builtIn"
msgstr "Встроенный"

msgid "plugins.generic.indexingPageManager.admin.sections.custom"
msgstr "Пользовательский"

msgid "plugins.generic.indexingPageManager.admin.sections.inactive"
msgstr "Скрыт"

msgid "plugins.generic.indexingPageManager.admin.sections.empty.title"
msgstr "Разделов пока нет."

msgid "plugins.generic.indexingPageManager.admin.sections.error.cannotDeleteBuiltIn"
msgstr "Встроенные разделы нельзя удалить. Чтобы скрыть раздел, сделайте его неактивным."

