# Plugin metadata --------------------------------------------------------

msgid "plugins.generic.indexingPageManager.name"
msgstr "Indexing Page Manager"

msgid "plugins.generic.indexingPageManager.description"
msgstr "A modern showcase of the indexing databases, discovery services and publishing platforms your journal works with — managed from a single admin panel, displayed on a dedicated page or embedded in your theme."

msgid "plugins.generic.indexingPageManager.action.manage"
msgstr "Manage Indexing Page"

# Navigation menu integration --------------------------------------------

msgid "plugins.generic.indexingPageManager.navMenuItem.title"
msgstr "Indexes & Databases page"

msgid "plugins.generic.indexingPageManager.navMenuItem.description"
msgstr "Links to the Indexing Page Manager showcase of the databases and platforms your journal is indexed in."

