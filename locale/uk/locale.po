# Plugin metadata --------------------------------------------------------

msgid "plugins.generic.indexingPageManager.name"
msgstr "Менеджер сторінки індексації"

msgid "plugins.generic.indexingPageManager.description"
msgstr "Сучасна вітрина баз даних індексації, сервісів відкриття та видавничих платформ, з якими працює ваш журнал — керується з єдиної адмін-панелі, відображається на окремій сторінці або вбудовується в тему."

msgid "plugins.generic.indexingPageManager.action.manage"
msgstr "Керувати сторінкою індексації"

# Navigation menu integration --------------------------------------------

msgid "plugins.generic.indexingPageManager.navMenuItem.title"
msgstr "Сторінка індексів і баз даних"

msgid "plugins.generic.indexingPageManager.navMenuItem.description"
msgstr "Посилання на вітрину Indexing Page Manager з базами даних і платформами, в яких індексується журнал."

